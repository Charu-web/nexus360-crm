generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DealStage {
  DISCOVERY
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DocumentStatus {
  UPLOADING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum DocumentType {
  PDF
  DOCX
  TXT
  CSV
}

enum WorkflowTriggerType {
  LEAD_CREATED
  LEAD_UPDATED
  LEAD_SCORE_CHANGED
  TASK_COMPLETED
  DOCUMENT_PROCESSED
}

enum WorkflowExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  AI_SCORE
  AI_CHAT
  AI_GENERATE_EMAIL
  WORKFLOW_TRIGGERED
  DOCUMENT_UPLOAD
  PERMISSION_CHANGE
}

// ==========================================
// 1. AUTHENTICATION & MULTI-TENANCY
// ==========================================

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique
  passwordHash       String
  fullName           String
  avatarUrl          String?
  phone              String?
  isActive           Boolean              @default(true)
  isEmailVerified    Boolean              @default(false)
  emailVerifyToken   String?
  passwordResetToken String?
  passwordResetExp   DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  memberships        OrganizationMember[]
  refreshTokens      RefreshToken[]
  assignedLeads      Lead[]               @relation("LeadAssignee")
  assignedTasks      Task[]               @relation("TaskAssignee")
  createdTasks       Task[]               @relation("TaskCreator")
  uploadedDocuments  Document[]
  auditLogs          AuditLog[]
  aiConversations    AIConversation[]
  activities         Activity[]

  @@index([email])
}

model Organization {
  id             String               @id @default(uuid()) @db.Uuid
  name           String
  slug           String               @unique
  logoUrl        String?
  website        String?
  plan           SubscriptionPlan     @default(STARTER)
  status         SubscriptionStatus   @default(TRIAL)
  trialEndsAt    DateTime?
  maxUsers       Int                  @default(10)
  maxLeads       Int                  @default(5000)
  maxDocuments   Int                  @default(100)
  maxAiCredits   Int                  @default(1000)
  usedAiCredits  Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  members        OrganizationMember[]
  leads          Lead[]
  companies      Company[]
  contacts       Contact[]
  deals          Deal[]
  tasks          Task[]
  activities     Activity[]
  documents      Document[]
  workflows      Workflow[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  aiConversations AIConversation[]
  invitations    Invitation[]
  pipelines      Pipeline[]

  @@index([slug])
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(EMPLOYEE)
  joinedAt       DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  role           OrganizationRole @default(EMPLOYEE)
  token          String           @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ==========================================
// 2. CRM MODULE (LEADS, COMPANIES, DEALS)
// ==========================================

model Company {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  domain         String?
  industry       String?
  size           String?
  country        String?
  website        String?
  phone          String?
  annualRevenue  Float?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]
  contacts       Contact[]
  deals          Deal[]

  @@index([organizationId])
  @@index([name])
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  companyId      String?      @db.Uuid
  name           String
  email          String
  phone          String?
  title          String?
  isPrimary      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model Pipeline {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String
  isDefault      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@index([organizationId])
}

model PipelineStage {
  id          String   @id @default(uuid()) @db.Uuid
  pipelineId  String   @db.Uuid
  name        String
  stageKey    String
  order       Int
  probability Int      @default(50)
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]

  @@index([pipelineId])
}

model Lead {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  name                String
  email               String?
  phone               String?
  companyName         String?
  companyId           String?        @db.Uuid
  source              String         @default("DIRECT")
  status              LeadStatus     @default(NEW)
  priority            LeadPriority   @default(MEDIUM)
  industry            String?
  estimatedValue      Float          @default(0)
  assignedUserId      String?        @db.Uuid
  tags                String[]       @default([])
  lastContactedAt     DateTime?
  notes               String?

  // AI Lead Scoring & Intelligence fields
  aiScore             Int?           // 0 - 100
  aiScoreConfidence   Float?         // 0.0 - 1.0
  aiScoreReason       String?
  aiRecommendedAction String?
  aiIntentSummary     String?
  aiRiskIndicators    String[]       @default([])
  aiScoredAt          DateTime?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company             Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedUser        User?          @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  tasks               Task[]
  activities          Activity[]
  deals               Deal[]

  @@index([organizationId])
  @@index([status])
  @@index([priority])
  @@index([aiScore])
  @@index([assignedUserId])
}

model Deal {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  title          String
  value          Float          @default(0)
  currency       String         @default("USD")
  stage          DealStage      @default(DISCOVERY)
  pipelineId     String?        @db.Uuid
  stageId        String?        @db.Uuid
  leadId         String?        @db.Uuid
  companyId      String?        @db.Uuid
  expectedClose  DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage  PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  lead           Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([stage])
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  leadId         String?      @db.Uuid
  assignedUserId String?      @db.Uuid
  createdById    String?      @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedUser   User?        @relation("TaskAssignee", fields: [assignedUserId], references: [id], onDelete: SetNull)
  creator        User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([status])
  @@index([dueDate])
  @@index([assignedUserId])
}

model Activity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  leadId         String?      @db.Uuid
  type           String       // CALL, EMAIL, MEETING, NOTE, AI_ACTION
  title          String
  description    String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
  @@index([createdAt])
}

// ==========================================
// 3. DOCUMENT INTELLIGENCE & RAG KNOWLEDGE BASE
// ==========================================

model Document {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  uploaderId     String          @db.Uuid
  name           String
  fileType       DocumentType
  fileSize       Int             // in bytes
  storageKey     String          // local or S3 key
  status         DocumentStatus  @default(QUEUED)
  chunksCount    Int             @default(0)
  errorMessage   String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader       User            @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  chunks         DocumentChunk[]

  @@index([organizationId])
  @@index([status])
}

model DocumentChunk {
  id             String                      @id @default(uuid()) @db.Uuid
  documentId     String                      @db.Uuid
  organizationId String                      @db.Uuid
  chunkIndex     Int
  content        String                      @db.Text
  tokenCount     Int                         @default(0)
  embedding      Unsupported("vector(1536)")?
  metadata       Json?
  createdAt      DateTime                    @default(now())

  document       Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([documentId])
}

// ==========================================
// 4. AI WORKFLOWS & AUTOMATION
// ==========================================

model Workflow {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  description    String?
  isActive       Boolean             @default(true)
  triggerType    WorkflowTriggerType
  nodes          Json                // Array of WorkflowNode JSON objects
  executionCount Int                 @default(0)
  lastExecutedAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions     WorkflowExecution[]

  @@index([organizationId])
  @@index([isActive])
}

model WorkflowExecution {
  id             String                  @id @default(uuid()) @db.Uuid
  workflowId     String                  @db.Uuid
  organizationId String                  @db.Uuid
  status         WorkflowExecutionStatus @default(PENDING)
  triggerEvent   String
  triggerData    Json?
  logs           Json                    // Array of step log objects
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  error          String?

  workflow       Workflow                @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
}

// ==========================================
// 5. AI CHAT & ASSISTANT CONVERSATIONS
// ==========================================

model AIConversation {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  userId         String      @db.Uuid
  title          String      @default("New AI Session")
  leadId         String?     @db.Uuid
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       AIMessage[]

  @@index([organizationId])
  @@index([userId])
}

model AIMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @db.Uuid
  role           String         // user | assistant | system | tool
  content        String         @db.Text
  toolCalls      Json?
  citations      Json?          // Array of { documentId, documentName, chunkIndex }
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ==========================================
// 6. NOTIFICATIONS & AUDIT LOGS
// ==========================================

model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  type           String       // LEAD_NEW, TASK_DUE, WORKFLOW_DONE, RAG_DONE
  title          String
  message        String
  link           String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String?      @db.Uuid
  action         AuditAction
  resource       String
  resourceId     String?
  details        String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
