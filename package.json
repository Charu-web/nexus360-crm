{
  "name": "empire-crm-backend",
  "version": "1.0.0",
  "description": "Production-ready Admin Panel backend for Empire CRM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "ts-node src/scripts/test_supabase_e2e.ts",
    "start": "node dist/server.js",
    "migrate": "ts-node src/scripts/run_supabase_migrations.ts",
    "test:e2e": "ts-node src/scripts/test_supabase_e2e.ts",
    "db:push": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "test:api": "ts-node src/scripts/test_admin_api.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.3.1",
    "@supabase/supabase-js": "^2.112.4",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.4",
    "prisma": "^6.3.1",
    "ssh2": "^1.17.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "ws": "^8.21.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
